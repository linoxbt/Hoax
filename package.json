{
  "name": "hoax",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/core && tsc -p packages/chain && tsc -p packages/db && tsc -p services/watcher && tsc -p demo",
    "test": "vitest run",
    "watcher": "npm run start -w @hoax/watcher",
    "web": "npm run dev -w @hoax/web",
    "db:migrate": "npm run migrate -w @hoax/db",
    "replay": "tsx demo/replay.ts",
    "spike:health": "tsx spike/01-health-read.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}

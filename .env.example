# --- watcher (services/watcher) and web (apps/web) share these -------------
# Postgres. Required: the watcher refuses to start without it (unless
# HOAX_ALLOW_MEMORY_STORE=1, for development), and a production web app
# refuses requests without it (unless HOAX_DEMO=1).
DATABASE_URL=postgres://hoax:hoax@localhost:5432/hoax
# The database's TLS certificate (PEM, or base64 of it). When set, the connection
# trusts this certificate and nothing else. deploy/vps-setup.sh writes it to
# netlify.env. A production web app needs it (or sslmode=verify-full) for any
# Postgres that is not on localhost.
DATABASE_CA_CERT=
# 1 = let a production web app use a remote Postgres without a verified certificate
# (a database on a private network only).
# DATABASE_INSECURE_TLS=

# Hideki overrides (the defaults are Somnia Hideki's public endpoints). The web app
# reads RPC_URL/WS_URL/INDEXER_URL for Hideki and SHANNON_RPC_URL for Shannon. A
# watcher reads RPC_URL/WS_URL/INDEXER_URL for whichever NETWORK it runs
# (docker-compose maps SHANNON_* onto the Shannon engine).
# RPC_URL=https://api.hideki2.infra.testnet.somnia.network
# WS_URL=wss://api.hideki2.infra.testnet.somnia.network/ws
# INDEXER_URL=https://hideki-dev.smk.somnia.host/v1/graphql
# SHANNON_RPC_URL=https://dream-rpc.somnia.network
# SHANNON_WS_URL=wss://dream-rpc.somnia.network/ws
# SHANNON_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
# Per-request RPC timeout in ms (viem's default 10 s is short for a cold fork).
# RPC_TIMEOUT_MS=

# Builder fee: Hoax attaches it only when the trader's on-chain approval covers it.
# bps x 1000, the pool's unit (5000 = 0.5 bps; pools cap at 10000 = 10 bps). 0 = no fee.
HOAX_BUILDER_ADDRESS=
HOAX_BUILDER_FEE_BPS_1K=0

# --- watcher only ----------------------------------------------------------
# Which network this engine protects: hideki or shannon. Run one engine per
# network; a second engine on the same network exits at start.
NETWORK=hideki
# docker compose: the Postgres password (deploy/vps-setup.sh generates one).
POSTGRES_PASSWORD=
# docker compose: where Postgres and the health endpoints listen on the host.
# POSTGRES_BIND=0.0.0.0
# POSTGRES_PUBLIC_PORT=5432
# HEALTH_BIND=127.0.0.1
# HEALTH_PORT=8080
# HEALTH_PORT_SHANNON=8081
# Encrypts the per-account Hoax keys at rest. At least 32 characters; keep it secret.
HOAX_KEYSTORE_SECRET=
KEYSTORE_DIR=./keystore
# Funds linked Hoax keys with STT for gas. Optional: without it traders top up the key in dreamDEX.
GAS_WALLET_PRIVATE_KEY=
GAS_MIN_BALANCE=0.15
GAS_DRIP_AMOUNT=0.25
GAS_PER_KEY_DAILY_CAP=0.75
GAS_DAILY_CAP=3
# The engine warns (hourly, and in /healthz as gasLow) when the gas wallet holds less than this.
GAS_WALLET_LOW=0.5
# true = decide and log, never send anything on chain (no orders, no gas).
DRY_RUN=false
TICK_MS=1000
PORT=8080
# Mark reads are shared across accounts for this many ms (0 = every read goes to chain).
# FEED_CACHE_MS=250
# An engine unhealthy this long (ms) exits so its supervisor restarts it.
# UNHEALTHY_EXIT_MS=120000
# 1 = run without a database (in memory, lost on restart). Development only.
# HOAX_ALLOW_MEMORY_STORE=

# --- web only ---------------------------------------------------------------
# HOAX_DEMO=1 runs the web app with no database or watcher: sample receipts and
# stats, engine shown offline. Markets and connected wallets are still read live.
HOAX_DEMO=
# Signs wallet sign-in sessions. At least 32 characters; keep it secret.
# Required on a production deployment.
HOAX_SESSION_SECRET=
# The site's hosts, comma-separated (read at build time and at runtime). Sign-in
# messages are only issued for these. Netlify's and Vercel's own site URLs are
# added automatically. A production deployment with none refuses sign-in; local
# development accepts any host.
HOAX_SITE_HOSTS=
# The site's canonical URL for page metadata (Netlify and Vercel set their own).
# HOAX_SITE_URL=https://hoax.example
# Behind a proxy other than Netlify or Vercel: the header it sets with the
# client's address (and overwrites when a client sends it), for rate limits.
# HOAX_CLIENT_IP_HEADER=x-real-ip
# 1 = no chain reads at all (CI builds).
# HOAX_OFFLINE=
# The browser wallet's RPCs (fixed at build time). Default to the public endpoints.
# NEXT_PUBLIC_RPC_URL=https://api.hideki2.infra.testnet.somnia.network
# NEXT_PUBLIC_SHANNON_RPC_URL=https://dream-rpc.somnia.network
# Reown Cloud project id (dashboard.reown.com, free). With it, Connect opens the Reown
# modal: installed wallets, WalletConnect QR for phones and more. Without it, Hoax
# lists the wallets installed in the browser. Add the site's domain to the project's allowlist.
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_DREAMDEX_APP_URL=https://app.testnet.dreamdex.io

# --- tests ------------------------------------------------------------------
# Also runs the store contract against this Postgres (it is wiped): npm test
# TEST_DATABASE_URL=postgres://hoax:hoax@localhost:5432/hoax_test

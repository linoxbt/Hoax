# --- watcher (services/watcher) and web (apps/web) share these -------------
# Postgres. Without it the watcher keeps everything in memory.
DATABASE_URL=postgres://hoax:hoax@localhost:5432/hoax

# Optional overrides; the defaults are Somnia Tokyo testnet (Hideki 2).
# RPC_URL=https://api.hideki2.infra.testnet.somnia.network
# WS_URL=wss://api.hideki2.infra.testnet.somnia.network/ws
# INDEXER_URL=https://hideki-dev.smk.somnia.host/v1/graphql

# Builder fee: Hoax attaches it only when the trader's on-chain approval covers it.
# bps x 1000, the pool's unit (5000 = 0.5 bps; pools cap at 10000 = 10 bps). 0 = no fee.
HOAX_BUILDER_ADDRESS=
HOAX_BUILDER_FEE_BPS_1K=0

# --- watcher only ----------------------------------------------------------
# Encrypts the per-account Hoax keys at rest. At least 32 characters; keep it secret.
HOAX_KEYSTORE_SECRET=
KEYSTORE_DIR=./keystore
# Funds linked Hoax keys with STT for gas. Optional: without it traders top up the key in dreamDEX.
GAS_WALLET_PRIVATE_KEY=
GAS_MIN_BALANCE=0.01
GAS_DRIP_AMOUNT=0.05
GAS_PER_KEY_DAILY_CAP=0.2
GAS_DAILY_CAP=2
# true = decide and log, never send an order.
DRY_RUN=false
TICK_MS=1000
PORT=8080

# --- web only ---------------------------------------------------------------
# HOAX_DEMO=1 runs the web app with no database or watcher: sample receipts and
# stats, engine shown offline. Markets and connected wallets are still read live.
HOAX_DEMO=
# Signs wallet sign-in sessions. At least 32 characters; keep it secret.
HOAX_SESSION_SECRET=
# The browser wallet's RPC (fixed at build time). Defaults to Hideki.
# NEXT_PUBLIC_RPC_URL=https://api.hideki2.infra.testnet.somnia.network
# Reown Cloud project id (dashboard.reown.com, free). With it, Connect opens the Reown
# modal: installed wallets, WalletConnect QR for phones and more. Without it, Hoax
# lists the wallets installed in the browser. Add the site's domain to the project's allowlist.
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_DREAMDEX_APP_URL=https://app.testnet.dreamdex.io
